  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "X\xE2y d\u1EF1ng khu v\u01B0\u1EDDn ph\xF2ng th\u1EE7 \u0111\u1EC3 ng\u0103n qu\xE1i v\u1EADt ph\xE1 h\u1EE7y nh\xE0 ch\xEDnh.\r\n\r\nTrong n\u0103m \u0111\u1EE3t \u0111\u1EA7u, b\u1EA1n b\u1EA3o v\u1EC7 HeartCrypt tr\xEAn hai tuy\u1EBFn \u0111\u01B0\u1EDDng. Khi ho\xE0n th\xE0nh \u0111\u1EE3t 5, hai khu m\u1EDBi m\u1EDF ra: VioletCrypt v\xE0 GoldenCrypt.\r\n\r\nSau m\u1EDF r\u1ED9ng, h\xE3y b\u1EA3o v\u1EC7 c\u1EA3 ba nh\xE0 c\xF9ng l\xFAc. Ch\u1EC9 c\u1EA7n m\u1ED9t nh\xE0 \u0111ang ho\u1EA1t \u0111\u1ED9ng h\u1EBFt m\xE1u, tr\u1EADn \u0111\u1EA5u k\u1EBFt th\xFAc.\r\n\r\nBa khu d\xF9ng chung m\u1ED9t v\xED ti\u1EC1n. H\xE3y d\xE0nh ti\u1EC1n cho c\u1EA3 ph\xF2ng th\u1EE7 v\xE0 c\xF4ng tr\xECnh s\u1EA3n xu\u1EA5t."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
